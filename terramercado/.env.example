# ───────────────── App ─────────────────
NEXT_PUBLIC_APP_NAME=TerraMercado
NEXT_PUBLIC_APP_URL=https://www.terramercado.com
NEXT_PUBLIC_APP_ENV=production

# ───────────────── Supabase ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────── Red de agentes n8n (Hetzner VPS) ─────────────────
N8N_BASE_URL=https://agents.terramercado.com
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=30000
N8N_WEBHOOK_TERRA_LENS=/webhook/terra-lens
N8N_WEBHOOK_COPILOTO=/webhook/copiloto-agronomico
N8N_WEBHOOK_FINANCIERO=/webhook/agente-financiero
N8N_WEBHOOK_REPUTACION=/webhook/calculo-terrascore
N8N_WEBHOOK_DISPUTA=/webhook/arbitraje-disputa

# ───────────────── Email transaccional ─────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_NOREPLY=noreply@terramercado.com
EMAIL_FROM_HOLA=hola@terramercado.com
EMAIL_FROM_SOPORTE=soporte@terramercado.com

# ───────────────── Pagos (Sprint 3+) ─────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────────── Storage ─────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_PRODUCTS=products
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_REVIEWS=reviews
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EVIDENCE=disputes

# ───────────────── Observabilidad ─────────────────
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
